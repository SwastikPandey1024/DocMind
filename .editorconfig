# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{json,js,mjs}]
indent_size = 2

[{package.json,tsconfig.json,.babelrc,.eslintrc,.prettierrc}]
indent_size = 2

[{Dockerfile,.dockerignore}]
indent_size = 4

