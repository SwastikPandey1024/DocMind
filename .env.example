# DocMind Environment Configuration
# Copy to .env and customize for your environment

# Application
APP_NAME=DocMind
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false

# Database
POSTGRES_DB=docmind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/docmind

# JWT
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage
UPLOAD_DIR=/app/storage/uploads
STORAGE_PATH=/app/storage
VECTORSTORE_PATH=/app/storage/vectorstore
MAX_UPLOAD_SIZE_MB=50

# Logging
LOG_LEVEL=INFO

# AI/ML - Embeddings
EMBEDDING_MODEL=bge-small

# AI/ML - OCR
OCR_LANGUAGE=en

# AI/ML - LLM
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Docker Registry (Production)
DOCKER_REGISTRY=docker.io
VERSION=latest
