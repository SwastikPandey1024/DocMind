# Production Environment Variables
# DO NOT commit this file - store in secret manager

APP_ENV=production
DEBUG=false

# Database - use managed PostgreSQL instance
POSTGRES_DB=docuchat_prod
POSTGRES_USER=docuchat_user
POSTGRES_PASSWORD=GENERATE_SECURE_PASSWORD
DATABASE_URL=postgresql+psycopg2://docuchat_user:GENERATE_SECURE_PASSWORD@postgres.example.com:5432/docuchat_prod

# Security
JWT_SECRET=GENERATE_SECURE_RANDOM_STRING_32_CHARS_MIN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage
UPLOAD_DIR=/mnt/data/uploads
MAX_UPLOAD_SIZE_MB=100

# Logging
LOG_LEVEL=INFO

# AI/ML
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OCR_LANGUAGE=en
OPENAI_API_KEY=
OLLAMA_HOST=http://ollama:11434

# Frontend
VITE_API_BASE_URL=https://api.docuchat.example.com

# Additional Production Settings
APP_NAME=DocuChat
APP_VERSION=1.0.0
